# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-optional

# Server Configuration
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=production
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173

# Google Search Console & Google Analytics 4 OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/oauth-callback.html

# SEMrush API (Optional - Hybrid table fallback available)
SEMRUSH_API=your-semrush-api-key

# OpenAI / ChatGPT API Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
